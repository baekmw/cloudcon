# KOPIS OpenAPI Key (공연예술통합전산망)
# https://www.kopis.or.kr/por/cs/openapi/openApiList.do?menuId=MNU_00074
KOPIS_API_KEY=your_kopis_api_key_here

# Google Gemini API Key (gemini-3.5-flash-lite 프로그램 자동 추출용)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key (매직 링크 이메일 인증 및 신규 공연 알림 메일 발송용)
# https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here

# Resend 발신자 이메일 (Resend에서 cloudcon.app 도메인 DNS 인증 후 사용)
RESEND_FROM_EMAIL="Cloudcon 클래식 알림 <noreply@cloudcon.app>"

# 매직 링크 생성 기준 도메인
APP_BASE_URL=https://cloudcon.app
